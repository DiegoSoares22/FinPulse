@model FinPulse.DTOs.LoginDTO

@{
    ViewData["Title"] = "Login - FinPulse";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card shadow border-0 rounded-4">
            <div class="card-body p-4">
                <h3 class="text-center fw-bold text-primary mb-4">🔐 Entrar no FinPulse</h3>

                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label">Usuário</label>
                        <input asp-for="UserName" class="form-control rounded-3" placeholder="Ex: diego" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Senha</label>
                        <input asp-for="Password" type="password" class="form-control rounded-3" placeholder="••••••••" required />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 rounded-3 fw-bold mt-2">
                        Acessar Sistema
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>