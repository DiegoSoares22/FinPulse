@model IEnumerable<FinPulse.DTOs.CategoriaDTO>

@{
    ViewData["Title"] = "Categorias - FinPulse";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>💰 Categorias Financeiras</h2>
        <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm">Sair</a>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>Tipo</th>
                        <th>Ícone</th>
                        <th>Cor</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.CategoriaId</td>
                                <td class="fw-bold">@item.Nome</td>
                                <td>
                                    <span class="badge @(item.Tipo == "Receita" ? "bg-success" : "bg-danger")">
                                        @item.Tipo
                                    </span>
                                </td>
                                <td>@item.Icone</td>
                                <td>
                                    <span class="badge" style="background-color: @item.Cor; color: #fff;">@item.Cor</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Nenhuma categoria encontrada.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>